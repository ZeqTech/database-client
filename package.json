{
  "name": "zeqs-database-client",
  "displayName": "Zeq's Database Client",
  "description": "Manage PostgreSQL, MySQL/MariaDB and SQLite connections in VS Code: browse tables, run SQL with per-editor connections, generate SQL, view and export DDL, and draw ER diagrams.",
  "version": "0.5.3",
  "publisher": "ZeqTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeqtech/database-client.git"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && node esbuild.js --production && vsce package --no-dependencies --allow-missing-repository",
    "publish": "npm run package && vsce publish --no-dependencies --allow-missing-repository"
  },
  "keywords": [
    "database",
    "sql",
    "postgresql",
    "postgres",
    "mysql",
    "mariadb",
    "sqlite",
    "query",
    "ddl",
    "er diagram"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e40af",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zeqs-query",
        "aliases": [
          "SQL (Zeq's Database Client)"
        ],
        "extensions": [
          ".zsql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zeqs-query",
        "scopeName": "source.zeqs-query",
        "path": "./syntaxes/zeqs-query.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbclient",
          "title": "Zeq's Database Client",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbclient": [
        {
          "id": "dbclient.connections",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbclient.connections",
        "contents": "No database connections yet.\n[Add Connection](command:dbclient.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "dbclient.addConnection",
        "title": "Add Connection",
        "category": "Database",
        "icon": "$(add)"
      },
      {
        "command": "dbclient.editConnection",
        "title": "Edit Connection",
        "category": "Database",
        "icon": "$(edit)"
      },
      {
        "command": "dbclient.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "Database"
      },
      {
        "command": "dbclient.deleteConnection",
        "title": "Delete Connection",
        "category": "Database",
        "icon": "$(trash)"
      },
      {
        "command": "dbclient.setGroup",
        "title": "Move to Group…",
        "category": "Database",
        "icon": "$(folder)"
      },
      {
        "command": "dbclient.setColor",
        "title": "Set Color…",
        "category": "Database",
        "icon": "$(symbol-color)"
      },
      {
        "command": "dbclient.renameGroup",
        "title": "Rename Group",
        "category": "Database"
      },
      {
        "command": "dbclient.removeGroup",
        "title": "Remove Group (Keep Connections)",
        "category": "Database"
      },
      {
        "command": "dbclient.disconnect",
        "title": "Close Connection",
        "category": "Database",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbclient.refresh",
        "title": "Refresh",
        "category": "Database",
        "icon": "$(refresh)"
      },
      {
        "command": "dbclient.openTable",
        "title": "Open Table Data",
        "category": "Database",
        "icon": "$(table)"
      },
      {
        "command": "dbclient.newQuery",
        "title": "New Query",
        "category": "Database",
        "icon": "$(new-file)"
      },
      {
        "command": "dbclient.showDiagram",
        "title": "Show ER Diagram",
        "category": "Database",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbclient.viewDdl",
        "title": "View DDL",
        "category": "Database",
        "icon": "$(code)"
      },
      {
        "command": "dbclient.generateSql",
        "title": "Generate SQL…",
        "category": "Database"
      },
      {
        "command": "dbclient.copyDdl",
        "title": "Copy DDL",
        "category": "Database"
      },
      {
        "command": "dbclient.exportDdl",
        "title": "Export DDL…",
        "category": "Database",
        "icon": "$(export)"
      },
      {
        "command": "dbclient.runQuery",
        "title": "Run Query (Selection or Statement at Cursor)",
        "category": "Database",
        "icon": "$(play)"
      },
      {
        "command": "dbclient.runAll",
        "title": "Run All Statements in File",
        "category": "Database",
        "icon": "$(run-all)"
      },
      {
        "command": "dbclient.selectConnection",
        "title": "Select Connection for This Editor",
        "category": "Database"
      },
      {
        "command": "dbclient.copyName",
        "title": "Copy Name",
        "category": "Database"
      },
      {
        "command": "dbclient.checkForUpdates",
        "title": "Check for Updates",
        "category": "Database"
      },
      {
        "command": "dbclient.reinstall",
        "title": "Reinstall Extension",
        "category": "Database"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbclient.addConnection",
          "when": "view == dbclient.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbclient.refresh",
          "when": "view == dbclient.connections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbclient.newQuery",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "inline@1"
        },
        {
          "command": "dbclient.editConnection",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "inline@2"
        },
        {
          "command": "dbclient.newQuery",
          "when": "viewItem == schema",
          "group": "query@1"
        },
        {
          "command": "dbclient.showDiagram",
          "when": "viewItem == schema",
          "group": "inline@1"
        },
        {
          "command": "dbclient.showDiagram",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "query@3"
        },
        {
          "command": "dbclient.showDiagram",
          "when": "viewItem =~ /^(table|view)$/",
          "group": "query@3"
        },
        {
          "command": "dbclient.generateSql",
          "when": "viewItem =~ /^(table|view)$/",
          "group": "query@1.5"
        },
        {
          "command": "dbclient.viewDdl",
          "when": "viewItem =~ /^(connection|connection-open|schema|table|view)$/",
          "group": "ddl@1"
        },
        {
          "command": "dbclient.copyDdl",
          "when": "viewItem =~ /^(connection|connection-open|schema|table|view)$/",
          "group": "ddl@2"
        },
        {
          "command": "dbclient.exportDdl",
          "when": "viewItem =~ /^(connection|connection-open|schema|table|view)$/",
          "group": "ddl@3"
        },
        {
          "command": "dbclient.openTable",
          "when": "viewItem =~ /^(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "dbclient.newQuery",
          "when": "viewItem =~ /^(table|view)$/",
          "group": "query@1"
        },
        {
          "command": "dbclient.copyName",
          "when": "viewItem =~ /^(table|view|column|schema)$/",
          "group": "query@2"
        },
        {
          "command": "dbclient.refresh",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "conn@1"
        },
        {
          "command": "dbclient.setGroup",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "org@1"
        },
        {
          "command": "dbclient.setColor",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "org@2"
        },
        {
          "command": "dbclient.renameGroup",
          "when": "viewItem == group",
          "group": "org@1"
        },
        {
          "command": "dbclient.removeGroup",
          "when": "viewItem == group",
          "group": "org@2"
        },
        {
          "command": "dbclient.disconnect",
          "when": "viewItem == connection-open",
          "group": "inline@0"
        },
        {
          "command": "dbclient.disconnect",
          "when": "viewItem == connection-open",
          "group": "conn@2"
        },
        {
          "command": "dbclient.duplicateConnection",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "conn@3"
        },
        {
          "command": "dbclient.deleteConnection",
          "when": "viewItem =~ /^(connection|connection-open)$/",
          "group": "conn@4"
        }
      ],
      "editor/title": [
        {
          "command": "dbclient.runQuery",
          "when": "editorLangId =~ /^(sql|zeqs-query)$/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbclient.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId =~ /^(sql|zeqs-query)$/"
      },
      {
        "command": "dbclient.runAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId =~ /^(sql|zeqs-query)$/"
      }
    ],
    "configuration": {
      "title": "Zeq's Database Client",
      "properties": {
        "dbclient.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 5000,
          "description": "Rows per page in the table data viewer."
        },
        "dbclient.update.source": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder containing `zeqs-database-client-<version>.vsix` files (newest is used), or a path to a single `.vsix`. Used by **Database: Check for Updates** and **Database: Reinstall Extension**."
        },
        "dbclient.update.checkOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Check the update source when VS Code starts and offer to install a newer version."
        },
        "dbclient.connectTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "description": "Seconds to wait for a PostgreSQL or MySQL connection (including SSL handshake) before giving up."
        },
        "dbclient.maxRows": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Maximum rows displayed for a query result."
        }
      }
    }
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.3"
  }
}
